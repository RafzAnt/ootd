APP_NAME=OOTD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-vercel-domain.example
APP_TIMEZONE=Asia/Manila

# Supabase Dashboard > Connect > Transaction pooler
DB_CONNECTION=pgsql
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
DB_POOLED=true

# Used by Laravel's migration commands. Copy the direct connection details
# from Supabase Dashboard > Connect. If running migrations from a network
# without IPv6 support, use the Supabase session pooler for migrations.
DB_DIRECT_HOST=db.PROJECT_REF.supabase.co
DB_DIRECT_PORT=5432
DB_DIRECT_DATABASE=postgres
DB_DIRECT_USERNAME=postgres
DB_DIRECT_PASSWORD=
DB_DIRECT_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
OOTD_IMAGE_STORAGE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=ootd
